{
  "name": "soyyagh-family-api",
  "version": "1.0.0",
  "description": "Backend REST API for the Al-Soyyagh family tree website",
  "main": "src/server.js",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file=.env src/server.js",
    "db:migrate": "node scripts/migrate.js",
    "db:import": "node scripts/import-excel.js",
    "db:import:dry": "node scripts/import-excel.js --dry-run",
    "seed:admin": "node scripts/seed-superadmin.js",
    "test": "node --test --env-file=.env test/*.test.js"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "arabic-persian-reshaper": "^1.0.1",
    "bcryptjs": "^3.0.3",
    "bidi-js": "^1.1.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  }
}
